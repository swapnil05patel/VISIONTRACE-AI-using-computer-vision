```gitignore
# ==========================================
# VisionTrace AI - Git Ignore
# ==========================================

# --------------------------
# Environment and secrets
# --------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.development.example
!.env.production.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/
service-account*.json

# --------------------------
# Dependencies
# --------------------------
node_modules/
**/node_modules/
.pnp/
.pnp.*
vendor/

# --------------------------
# Python environments
# --------------------------
.venv/
venv/
env/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --------------------------
# Build output
# --------------------------
dist/
build/
out/
.next/
.nuxt/
.output/
coverage/
*.tsbuildinfo
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Preserve source inside artifacts/
artifacts/*/dist/
artifacts/*/build/
artifacts/*/node_modules/
artifacts/**/__pycache__/
artifacts/**/.pytest_cache/

# --------------------------
# IDE and operating system
# --------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
.directory

# --------------------------
# Local databases and runtime
# --------------------------
*.sqlite
*.sqlite3
*.db
*.pid
*.sock
tmp/
temp/
logs/

# --------------------------
# Private uploads and generated media
# --------------------------
uploads/
**/uploads/
artifacts/api-server/data/objects/uploads/
generated-artifacts/
recordings/

# --------------------------
# Generated vector indexes
# --------------------------
*.faiss
*.faiss.meta.json

# --------------------------
# Data: exclude by default
# --------------------------
data/*

# Include benchmark manifests
!data/dataset-imports/
!data/dataset-imports/*.json

# Include benchmark fixtures
!data/dataset-fixtures/
!data/dataset-fixtures/**

# Include test images - review privacy and licensing first
!data/test images/
!data/test images/**

# Include training metadata and model weights
!data/training/
!data/training/*.json
!data/training/*.pth

# Explicitly exclude sensitive or generated datasets
data/samples/
data/videos/
data/aicity_raw/
data/visiontrace.faiss
data/visiontrace.faiss.meta.json

# --------------------------
# Model weights
# --------------------------
# Do not ignore *.pt, *.pth, *.onnx or *.safetensors.
# These files are managed through Git LFS.

# --------------------------
# Local configuration
# --------------------------
*.local
*.bak
*.backup
*.orig
*.rej
# Python virtual environments
venv/
**/venv/
.venv/
**/.venv/
# Duplicate root-level model
/yolo11n.pt
